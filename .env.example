# ─── AI Code Review Assistant ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the .env file — it's in .gitignore.

# ── LLM Provider (choose one or both) ──────────────────────────
# Google Gemini
GEMINI_API_KEY=

# OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# ── Semgrep ────────────────────────────────────────────────────
# Path to the semgrep binary. Leave blank to auto-detect from PATH.
SEMGREP_PATH=

# ── Backend ────────────────────────────────────────────────────
# Host and port for the FastAPI server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Database ───────────────────────────────────────────────────
# SQLite database path for feedback storage
FEEDBACK_DB_PATH=.tmp/feedback.db

# ── LLM Settings ──────────────────────────────────────────────
# Which provider to use: "gemini" or "openai"
LLM_PROVIDER=gemini
# Model name (e.g., gemini-2.0-flash, gpt-4o-mini)
LLM_MODEL=gemini-2.0-flash
